# Copy to .env and adjust. All values below are the defaults.

# Local models served by Ollama (pull them once: ollama pull gemma3:4b && ollama pull nomic-embed-text)
OLLAMA_MODEL=gemma3:4b
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_BASE_URL=http://localhost:11434
# Context window in tokens: the question plus the retrieved chunks must fit in it.
OLLAMA_NUM_CTX=8192

# RAG knobs: the first things worth experimenting with
RAGMATE_CHUNK_SIZE=800
RAGMATE_CHUNK_OVERLAP=120
RAGMATE_TOP_K=4
# How many times the agent may rewrite a query before admitting "not found"
RAGMATE_MAX_RETRIES=2

# Where the vector store (Chroma), the ingest manifest and uploads are kept.
# Relative paths are taken from the project root; `.ragmate/` is gitignored.
RAGMATE_HOME=.ragmate
